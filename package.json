{
  "name": "phantom-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/kit",
    "apps/spinlab",
    "apps/cardforge",
    "recipes/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test",
    "provenance:check": "node scripts/provenance/check.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "preact": "^11.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
